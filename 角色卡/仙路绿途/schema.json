{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "type": "object",
      "properties": {
        "当前时间": {
          "type": "string"
        },
        "当前地点": {
          "type": "string"
        },
        "当前事件": {
          "type": "string"
        }
      },
      "required": [
        "当前时间",
        "当前地点",
        "当前事件"
      ]
    },
    "姜清曦": {
      "type": "object",
      "properties": {
        "好感度": {
          "type": "number"
        },
        "心理状态": {
          "type": "string"
        },
        "修为境界": {
          "type": "string"
        },
        "道心状态": {
          "type": "string"
        },
        "着装": {
          "type": "string"
        },
        "当前位置": {
          "type": "string"
        }
      },
      "required": [
        "好感度",
        "心理状态",
        "修为境界",
        "道心状态",
        "着装",
        "当前位置"
      ]
    },
    "主角": {
      "type": "object",
      "properties": {
        "身体状态": {
          "type": "string"
        },
        "心理活动": {
          "type": "string"
        },
        "物品栏": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "物品名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "type": "string"
              },
              "数量": {
                "type": "number"
              }
            },
            "required": [
              "描述",
              "数量"
            ]
          }
        }
      },
      "required": [
        "身体状态",
        "心理活动",
        "物品栏"
      ]
    }
  },
  "required": [
    "世界",
    "姜清曦",
    "主角"
  ]
}