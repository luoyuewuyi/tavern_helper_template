{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "type": "object",
      "properties": {
        "当前时间": {
          "type": "string"
        },
        "当前地点": {
          "type": "string"
        },
        "日期": {
          "type": "string"
        },
        "当前阶段": {
          "type": "string"
        },
        "近期事务": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "事务名"
          },
          "additionalProperties": {
            "type": "string",
            "description": "事务描述"
          }
        }
      },
      "required": [
        "当前时间",
        "当前地点",
        "日期",
        "当前阶段",
        "近期事务"
      ]
    },
    "干员信赖": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "角色名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "信赖值": {
            "type": "number"
          },
          "阶段": {
            "type": "string"
          }
        },
        "required": [
          "信赖值",
          "阶段"
        ]
      }
    },
    "当前交互角色": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "角色名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "姓名": {
            "type": "string"
          },
          "性别": {
            "type": "string"
          },
          "种族": {
            "type": "string"
          },
          "身份": {
            "type": "string"
          },
          "矿石病感染情况": {
            "type": "string"
          },
          "源石技艺": {
            "type": "string"
          },
          "兴趣爱好": {
            "type": "string"
          },
          "关系网": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "description": "人物名"
            },
            "additionalProperties": {
              "type": "string",
              "description": "关系描述"
            }
          },
          "容貌": {
            "type": "string"
          },
          "身材": {
            "type": "string"
          },
          "着装": {
            "type": "string"
          },
          "神态": {
            "type": "string"
          },
          "体态": {
            "type": "string"
          },
          "内心": {
            "type": "string"
          },
          "当前携带物品": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "description": "物品名"
            },
            "additionalProperties": {
              "type": "string",
              "description": "物品描述"
            }
          },
          "密录": {
            "type": "string"
          },
          "角色记忆": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "好感度": {
            "type": "number"
          },
          "欲望值": {
            "type": "number"
          },
          "敏感度": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "description": "部位"
            },
            "additionalProperties": {
              "type": "string",
              "description": "敏感等级"
            }
          },
          "开发度": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "description": "类型"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "姓名",
          "性别",
          "种族",
          "身份",
          "矿石病感染情况",
          "源石技艺",
          "兴趣爱好",
          "关系网",
          "容貌",
          "身材",
          "着装",
          "神态",
          "体态",
          "内心",
          "当前携带物品",
          "密录",
          "角色记忆",
          "好感度",
          "欲望值",
          "敏感度",
          "开发度"
        ]
      }
    },
    "博士": {
      "type": "object",
      "properties": {
        "物品栏": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "物品名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "type": "string"
              },
              "数量": {
                "type": "number"
              }
            },
            "required": [
              "描述",
              "数量"
            ]
          }
        }
      },
      "required": [
        "物品栏"
      ]
    }
  },
  "required": [
    "世界",
    "干员信赖",
    "当前交互角色",
    "博士"
  ]
}