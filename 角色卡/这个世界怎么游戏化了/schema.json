{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "type": "object",
      "properties": {
        "世界类型": {
          "default": "待设定",
          "type": "string"
        },
        "当前时间": {
          "default": "待初始化",
          "type": "string"
        },
        "当前地点": {
          "default": "待初始化",
          "type": "string"
        },
        "世界规则摘要": {
          "default": "由开局输入决定；若留空，由AI生成一个可游玩的现实/奇幻/科幻/同人世界。",
          "type": "string"
        },
        "近期事件": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "事件名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "default": "待记录",
                "type": "string"
              },
              "影响": {
                "default": "暂无",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "玩家": {
      "type": "object",
      "properties": {
        "姓名": {
          "default": "{{user}}",
          "type": "string"
        },
        "年龄": {
          "default": "待设定",
          "type": "string"
        },
        "外表": {
          "default": "待设定",
          "type": "string"
        },
        "背景": {
          "default": "待设定",
          "type": "string"
        },
        "身份": {
          "default": "待设定",
          "type": "string"
        },
        "等级": {
          "default": 1,
          "type": "number"
        },
        "经验": {
          "type": "number"
        },
        "可用技能点": {
          "type": "number"
        },
        "金钱": {
          "type": "number"
        },
        "声望": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "圈层或势力名"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "当前状态": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "状态名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "default": "待记录",
                "type": "string"
              },
              "剩余": {
                "default": "未知",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "技能": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "技能大类"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "description": "技能名"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "等级": {
              "default": 1,
              "type": "number"
            },
            "经验": {
              "type": "number"
            },
            "描述": {
              "default": "待记录",
              "type": "string"
            },
            "来源": {
              "default": "背景或剧情获得",
              "type": "string"
            }
          }
        }
      }
    },
    "任务": {
      "type": "object",
      "properties": {
        "活跃": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "任务名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "发布者": {
                "default": "未知",
                "type": "string"
              },
              "类型": {
                "default": "支线",
                "type": "string",
                "enum": [
                  "主线",
                  "支线",
                  "日常",
                  "临机"
                ]
              },
              "目标": {
                "default": "待明确",
                "type": "string"
              },
              "难度": {
                "default": "低",
                "type": "string",
                "enum": [
                  "低",
                  "中",
                  "高",
                  "突破"
                ]
              },
              "奖励": {
                "type": "object",
                "properties": {
                  "技能经验": {
                    "default": 1,
                    "type": "number"
                  },
                  "金钱": {
                    "type": "number"
                  },
                  "道具": {
                    "default": "无",
                    "type": "string"
                  },
                  "其他": {
                    "default": "无",
                    "type": "string"
                  }
                }
              },
              "状态": {
                "default": "可接取",
                "type": "string",
                "enum": [
                  "可接取",
                  "进行中",
                  "可提交"
                ]
              },
              "隐性价值": {
                "default": "无",
                "type": "string"
              }
            },
            "required": [
              "奖励"
            ]
          }
        },
        "已完成": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "任务名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "完成时间": {
                "default": "未知",
                "type": "string"
              },
              "结果": {
                "default": "已完成",
                "type": "string"
              },
              "奖励去向": {
                "default": "待分配",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "人物": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "人物名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "身份": {
            "default": "待记录",
            "type": "string"
          },
          "关系": {
            "default": "陌生",
            "type": "string"
          },
          "好感": {
            "type": "number"
          },
          "可发布任务倾向": {
            "default": "未知",
            "type": "string"
          },
          "备注": {
            "default": "无",
            "type": "string"
          }
        }
      }
    },
    "背包": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "物品名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "描述": {
            "default": "待记录",
            "type": "string"
          },
          "数量": {
            "default": 1,
            "type": "number"
          },
          "来源": {
            "default": "未知",
            "type": "string"
          }
        }
      }
    },
    "系统": {
      "type": "object",
      "properties": {
        "当前提示": {
          "default": "技能与任务系统已激活。",
          "type": "string"
        },
        "待分配技能经验": {
          "type": "number"
        },
        "日志": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "日志编号"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "时间": {
                "default": "未知",
                "type": "string"
              },
              "内容": {
                "default": "待记录",
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "世界",
    "玩家",
    "任务",
    "系统"
  ]
}