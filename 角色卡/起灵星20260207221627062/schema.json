{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "type": "object",
      "properties": {
        "当前时间": {
          "type": "string"
        },
        "当前地点": {
          "type": "string"
        },
        "当前大陆": {
          "type": "string"
        },
        "当前坐标": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        }
      },
      "required": [
        "当前时间",
        "当前地点",
        "当前大陆",
        "当前坐标"
      ]
    },
    "角色库": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "角色名"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "好感度": {
            "type": "number"
          },
          "信赖度": {
            "type": "number"
          },
          "修为境界": {
            "type": "string"
          },
          "身份": {
            "type": "string"
          },
          "当前行动": {
            "type": "string"
          },
          "当前内心": {
            "type": "string"
          },
          "着装": {
            "type": "string"
          },
          "状态": {
            "type": "string"
          }
        },
        "required": [
          "好感度",
          "信赖度",
          "修为境界",
          "身份",
          "当前行动",
          "当前内心",
          "着装",
          "状态"
        ]
      }
    },
    "主角": {
      "type": "object",
      "properties": {
        "修为境界": {
          "type": "string"
        },
        "灵根": {
          "type": "string"
        },
        "灵石": {
          "type": "number"
        },
        "物品栏": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "物品名"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "描述": {
                "type": "string"
              },
              "数量": {
                "type": "number"
              }
            },
            "required": [
              "描述",
              "数量"
            ]
          }
        }
      },
      "required": [
        "修为境界",
        "灵根",
        "灵石",
        "物品栏"
      ]
    }
  },
  "required": [
    "世界",
    "角色库",
    "主角"
  ]
}